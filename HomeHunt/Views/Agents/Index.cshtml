@model List<AgentListViewModel>

@{
    ViewData["Title"] = "Agents";
}

<h1 class="h2 mb-3">Agents</h1>

<div class="table-responsive">
    <table class="table table-striped table-hover align-middle">
        <thead>
            <tr>
                <th>Name</th>
                <th>Agency</th>
                <th>Email</th>
                <th>Phone</th>
                <th>Properties</th>
            </tr>
        </thead>
        <tbody>
            @foreach (AgentListViewModel agent in Model)
            {
                <tr>
                    <td>@agent.FirstName @agent.LastName</td>
                    <td>@agent.AgencyName</td>
                    <td>@agent.Email</td>
                    <td>@agent.Phone</td>
                    <td><span class="badge bg-primary">@agent.PropertyCount</span></td>
                </tr>
            }
        </tbody>
    </table>
</div>

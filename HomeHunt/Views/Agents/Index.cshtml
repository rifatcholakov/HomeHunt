@model List<AgentListViewModel>

@{
    ViewData["Title"] = "Agents";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h2 mb-0">Agents</h1>
    <a class="btn btn-primary" asp-action="Create">Add Agent</a>
</div>

<div class="table-responsive">
    <table class="table table-striped table-hover align-middle">
        <thead>
            <tr>
                <th>Name</th>
                <th>Agency</th>
                <th>Email</th>
                <th>Phone</th>
                <th>Properties</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (AgentListViewModel agent in Model)
            {
                <tr>
                    <td>@agent.FirstName @agent.LastName</td>
                    <td>@agent.AgencyName</td>
                    <td>@agent.Email</td>
                    <td>@agent.Phone</td>
                    <td><span class="badge bg-primary">@agent.PropertyCount</span></td>
                    <td class="text-end">
                        <a class="btn btn-sm btn-outline-primary" asp-action="Details" asp-route-id="@agent.Id">Details</a>
                        <a class="btn btn-sm btn-outline-secondary" asp-action="Edit" asp-route-id="@agent.Id">Edit</a>
                        <a class="btn btn-sm btn-outline-danger" asp-action="Delete" asp-route-id="@agent.Id">Delete</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

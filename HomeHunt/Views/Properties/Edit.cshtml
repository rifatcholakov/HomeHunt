@model PropertyFormViewModel

@{
    ViewData["Title"] = "Edit Property";
}

<h1 class="h2 mb-3">Edit Property</h1>

<div class="row">
    <div class="col-lg-8">
        <form asp-action="Edit" asp-route-id="@Model.Id" method="post">
            <partial name="_PropertyForm" model="Model" />

            <button type="submit" class="btn btn-primary">Save</button>
            <a class="btn btn-outline-secondary" asp-action="Details" asp-route-id="@Model.Id">Cancel</a>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

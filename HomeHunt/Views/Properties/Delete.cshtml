@model PropertyDetailsViewModel

@{
    ViewData["Title"] = "Delete Property";
}

<h1 class="h2 mb-3">Delete Property</h1>

<div class="alert alert-danger">
    Are you sure you want to delete this property? This cannot be undone.
</div>

<div class="card mb-3">
    <div class="card-body">
        <dl class="row mb-0">
            <dt class="col-sm-3">Title</dt>
            <dd class="col-sm-9">@Model.Title</dd>

            <dt class="col-sm-3">Location</dt>
            <dd class="col-sm-9">@Model.Neighborhood, @Model.City</dd>

            <dt class="col-sm-3">Type</dt>
            <dd class="col-sm-9">@Model.PropertyType</dd>

            <dt class="col-sm-3">Listing</dt>
            <dd class="col-sm-9">@Model.ListingType</dd>

            <dt class="col-sm-3">Price</dt>
            <dd class="col-sm-9">&euro;@Model.Price.ToString("N0")</dd>
        </dl>
    </div>
</div>

<form asp-action="Delete" asp-route-id="@Model.Id" method="post">
    <button type="submit" class="btn btn-danger">Yes, delete</button>
    <a class="btn btn-outline-secondary" asp-action="Details" asp-route-id="@Model.Id">Cancel</a>
</form>

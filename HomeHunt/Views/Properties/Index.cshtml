@model List<PropertyListViewModel>

@{
    ViewData["Title"] = "All Properties";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h2 mb-0">All Properties</h1>
    <a class="btn btn-primary" asp-action="Create">Add Property</a>
</div>

@if (Model.Count == 0)
{
    <p class="text-muted">There are no properties yet.</p>
}
else
{
    <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
        @foreach (PropertyListViewModel property in Model)
        {
            <partial name="_PropertyCard" model="property" />
        }
    </div>
}

@model List<LocationListViewModel>

@{
    ViewData["Title"] = "Locations";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h2 mb-0">Locations</h1>
    <a class="btn btn-primary" asp-action="Create">Add Location</a>
</div>

<div class="table-responsive">
    <table class="table table-striped table-hover align-middle">
        <thead>
            <tr>
                <th>City</th>
                <th>Neighborhood</th>
                <th>Postal code</th>
                <th>Properties</th>
            </tr>
        </thead>
        <tbody>
            @foreach (LocationListViewModel location in Model)
            {
                <tr>
                    <td>@location.City</td>
                    <td>@location.Neighborhood</td>
                    <td>@location.PostalCode</td>
                    <td><span class="badge bg-primary">@location.PropertyCount</span></td>
                </tr>
            }
        </tbody>
    </table>
</div>

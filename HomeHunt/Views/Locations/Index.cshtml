@model List<LocationListViewModel>

@{
    ViewData["Title"] = "Locations";
}

<h1 class="h2 mb-3">Locations</h1>

<div class="table-responsive">
    <table class="table table-striped table-hover align-middle">
        <thead>
            <tr>
                <th>City</th>
                <th>Neighborhood</th>
                <th>Postal code</th>
                <th>Properties</th>
            </tr>
        </thead>
        <tbody>
            @foreach (LocationListViewModel location in Model)
            {
                <tr>
                    <td>@location.City</td>
                    <td>@location.Neighborhood</td>
                    <td>@location.PostalCode</td>
                    <td><span class="badge bg-primary">@location.PropertyCount</span></td>
                </tr>
            }
        </tbody>
    </table>
</div>

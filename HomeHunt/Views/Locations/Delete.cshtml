@model LocationDetailsViewModel

@{
    ViewData["Title"] = "Delete Location";
}

<h1 class="h2 mb-3">Delete Location</h1>

<div class="alert alert-danger">
    Are you sure you want to delete this location? This cannot be undone.
    @if (Model.PropertyCount > 0)
    {
        <strong>All @Model.PropertyCount properties in this location will be deleted too.</strong>
    }
</div>

<div class="card mb-3">
    <div class="card-body">
        <dl class="row mb-0">
            <dt class="col-sm-3">City</dt>
            <dd class="col-sm-9">@Model.City</dd>

            <dt class="col-sm-3">Neighborhood</dt>
            <dd class="col-sm-9">@Model.Neighborhood</dd>

            <dt class="col-sm-3">Postal code</dt>
            <dd class="col-sm-9">@Model.PostalCode</dd>

            <dt class="col-sm-3">Properties</dt>
            <dd class="col-sm-9">@Model.PropertyCount</dd>
        </dl>
    </div>
</div>

<form asp-action="Delete" asp-route-id="@Model.Id" method="post">
    <button type="submit" class="btn btn-danger">Yes, delete</button>
    <a class="btn btn-outline-secondary" asp-action="Details" asp-route-id="@Model.Id">Cancel</a>
</form>

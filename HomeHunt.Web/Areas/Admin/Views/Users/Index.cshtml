@model UserIndexViewModel

@{
    ViewData["Title"] = "Users";
}

<h1 class="h2 mb-3">Users</h1>

<form asp-action="Index" method="get" class="row g-2 mb-3">
    <div class="col-sm-8 col-md-6 col-lg-4">
        <input type="search" name="search" value="@Model.Search" class="form-control" placeholder="Search by email" aria-label="Search by email" />
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-primary">Search</button>
        <a class="btn btn-outline-secondary" asp-action="Index">Clear</a>
    </div>
</form>

<div class="table-responsive">
    <table class="table table-striped table-hover align-middle">
        <thead>
            <tr>
                <th>Email</th>
                <th>Roles</th>
                <th>Properties</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (UserListViewModel user in Model.Items)
            {
                <tr>
                    <td>
                        @user.Email
                        @if (user.IsCurrentUser)
                        {
                            <span class="badge bg-light text-dark border ms-1">You</span>
                        }
                    </td>
                    <td>
                        @foreach (string role in user.Roles)
                        {
                            <span class="badge @(role == Roles.Administrator ? "bg-danger" : role == Roles.Agent ? "bg-primary" : "bg-secondary")">@role</span>
                        }
                    </td>
                    <td>
                        @if (user.AgentId != null)
                        {
                            <a asp-area="" asp-controller="Agents" asp-action="Details" asp-route-id="@user.AgentId">@user.PropertyCount</a>
                        }
                    </td>
                    <td class="text-end">
                        @if (!user.IsCurrentUser)
                        {
                            <div class="d-inline-flex gap-1">
                                <a class="btn btn-sm btn-outline-primary" asp-action="ChangeRole" asp-route-id="@user.Id">Change role</a>
                                @if (!user.IsAdministrator)
                                {
                                    <a class="btn btn-sm btn-outline-danger" asp-action="Delete" asp-route-id="@user.Id">Delete</a>
                                }
                            </div>
                        }
                    </td>
                </tr>
            }
            @if (Model.Items.Count == 0)
            {
                <tr><td colspan="4" class="text-center text-muted py-4">No users match your search.</td></tr>
            }
        </tbody>
    </table>
</div>

<partial name="_Pagination" model="Model.Pagination" />

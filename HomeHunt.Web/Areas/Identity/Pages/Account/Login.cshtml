@page
@model LoginModel
@{
    ViewData["Title"] = "Log in";
}

<div class="row justify-content-center align-items-center g-4 my-4">
    <div class="col-md-8 col-lg-5">
        <h2 class="display-6 fw-bold mb-2">Welcome <span class="text-primary">back</span></h2>
        <p class="lead text-muted mb-4">Log in to continue your home search.</p>

        <ul class="list-unstyled mb-0">
            <li class="d-flex align-items-start mb-3">
                <span class="badge rounded-circle bg-primary me-3">&#10003;</span>
                <span>Search and filter every property</span>
            </li>
            <li class="d-flex align-items-start mb-3">
                <span class="badge rounded-circle bg-primary me-3">&#10003;</span>
                <span>Open listings and contact the agents</span>
            </li>
            <li class="d-flex align-items-start">
                <span class="badge rounded-circle bg-primary me-3">&#10003;</span>
                <span>Agents can add and manage their own listings</span>
            </li>
        </ul>
    </div>

    <div class="col-md-8 col-lg-5">
        <div class="card shadow-sm">
            <div class="card-body p-4">
                <h1 class="h3 mb-4">Log in</h1>

                <form id="account" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>

                    <div class="mb-3">
                        <label asp-for="Input.Email" class="form-label">Email</label>
                        <input asp-for="Input.Email" class="form-control" autocomplete="username" aria-required="true" />
                        <span asp-validation-for="Input.Email" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Input.Password" class="form-label">Password</label>
                        <input asp-for="Input.Password" class="form-control" autocomplete="current-password" aria-required="true" />
                        <span asp-validation-for="Input.Password" class="text-danger"></span>
                    </div>

                    <div class="form-check mb-4">
                        <input class="form-check-input" asp-for="Input.RememberMe" />
                        <label class="form-check-label" asp-for="Input.RememberMe">@Html.DisplayNameFor(m => m.Input.RememberMe)</label>
                    </div>

                    <button id="login-submit" type="submit" class="w-100 btn btn-primary">Log in</button>
                </form>

                @if ((Model.ExternalLogins?.Count ?? 0) > 0)
                {
                    <form id="external-account" asp-page="./ExternalLogin" asp-route-returnUrl="@Model.ReturnUrl" method="post" class="d-grid gap-2 mt-3">
                        @foreach (var provider in Model.ExternalLogins!)
                        {
                            <button type="submit" class="btn btn-outline-secondary" name="provider" value="@provider.Name" title="Log in using your @provider.DisplayName account">@provider.DisplayName</button>
                        }
                    </form>
                }

                <hr class="my-4" />

                <p class="mb-1">
                    Don't have an account? <a asp-page="./Register" asp-route-returnUrl="@Model.ReturnUrl">Register</a>
                </p>
                <p class="mb-0">
                    Are you a real estate agent? <a asp-page="./RegisterAgent" asp-route-returnUrl="@Model.ReturnUrl">Register as an agent</a>
                </p>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

@page
@model RegisterModel
@{
    ViewData["Title"] = "Register";
}

<div class="row justify-content-center align-items-center g-4 my-4">
    <div class="col-md-8 col-lg-5">
        <h2 class="display-6 fw-bold mb-2">Find your next <span class="text-primary">home</span></h2>
        <p class="lead text-muted mb-4">Create a free account and start exploring.</p>

        <ul class="list-unstyled mb-0">
            <li class="d-flex align-items-start mb-3">
                <span class="badge rounded-circle bg-primary me-3">&#10003;</span>
                <span>Search by city, type, price, bedrooms and area</span>
            </li>
            <li class="d-flex align-items-start mb-3">
                <span class="badge rounded-circle bg-primary me-3">&#10003;</span>
                <span>See every listing's details and location</span>
            </li>
            <li class="d-flex align-items-start">
                <span class="badge rounded-circle bg-primary me-3">&#10003;</span>
                <span>Contact the agent behind each property</span>
            </li>
        </ul>
    </div>

    <div class="col-md-8 col-lg-5">
        <div class="card shadow-sm">
            <div class="card-body p-4">
                <h1 class="h3 mb-4">Create an account</h1>

                <form id="registerForm" asp-route-returnUrl="@Model.ReturnUrl" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>

                    <div class="mb-3">
                        <label asp-for="Input.Email" class="form-label">Email</label>
                        <input asp-for="Input.Email" class="form-control" autocomplete="username" aria-required="true" />
                        <span asp-validation-for="Input.Email" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Input.Password" class="form-label">Password</label>
                        <input asp-for="Input.Password" class="form-control" autocomplete="new-password" aria-required="true" />
                        <span asp-validation-for="Input.Password" class="text-danger"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="Input.ConfirmPassword" class="form-label">Confirm password</label>
                        <input asp-for="Input.ConfirmPassword" class="form-control" autocomplete="new-password" aria-required="true" />
                        <span asp-validation-for="Input.ConfirmPassword" class="text-danger"></span>
                    </div>

                    <button id="registerSubmit" type="submit" class="w-100 btn btn-primary">Register</button>
                </form>

                <hr class="my-4" />

                <p class="mb-1">
                    Already have an account? <a asp-page="./Login" asp-route-returnUrl="@Model.ReturnUrl">Log in</a>
                </p>
                <p class="mb-0">
                    Are you a real estate agent? <a asp-page="./RegisterAgent" asp-route-returnUrl="@Model.ReturnUrl">Register as an agent</a>
                </p>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

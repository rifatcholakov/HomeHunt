@page
@model UpgradeToAgentModel
@{
    ViewData["Title"] = "Become an agent";
}

<div class="row justify-content-center my-4">
    <div class="col-md-8 col-lg-6">
        <div class="card shadow-sm">
            <div class="card-body p-4">
                <h1 class="h3 mb-3">Become an agent</h1>
                <p class="text-muted mb-4">
                    Only agents can list properties. Upgrading your account to an agent account will be available here soon.
                </p>
                <a class="btn btn-primary" asp-controller="Home" asp-action="Index">Back to home</a>
            </div>
        </div>
    </div>
</div>

@page
@model RegisterAgentModel
@{
    ViewData["Title"] = "Register as an agent";
}

<div class="row justify-content-center my-4">
    <div class="col-md-10 col-lg-6">
        <div class="card shadow-sm">
            <div class="card-body p-4">
                <h1 class="h3 mb-4">Register as an agent</h1>

                <form id="registerAgentForm" asp-route-returnUrl="@Model.ReturnUrl" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>

                    <div class="row">
                        <div class="col-sm-6 mb-3">
                            <label asp-for="Input.FirstName" class="form-label"></label>
                            <input asp-for="Input.FirstName" class="form-control" aria-required="true" />
                            <span asp-validation-for="Input.FirstName" class="text-danger"></span>
                        </div>
                        <div class="col-sm-6 mb-3">
                            <label asp-for="Input.LastName" class="form-label"></label>
                            <input asp-for="Input.LastName" class="form-control" aria-required="true" />
                            <span asp-validation-for="Input.LastName" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Input.Email" class="form-label">Email</label>
                        <input asp-for="Input.Email" class="form-control" autocomplete="username" aria-required="true" />
                        <span asp-validation-for="Input.Email" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Input.Phone" class="form-label">Phone</label>
                        <input asp-for="Input.Phone" class="form-control" autocomplete="tel" placeholder="+359888123456" aria-required="true" />
                        <span asp-validation-for="Input.Phone" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Input.AgencyName" class="form-label">Agency (optional)</label>
                        <input asp-for="Input.AgencyName" class="form-control" />
                        <span asp-validation-for="Input.AgencyName" class="text-danger"></span>
                        <div class="form-text">@DisplayConstants.AgencyHint</div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Input.Password" class="form-label">Password</label>
                        <input asp-for="Input.Password" class="form-control" autocomplete="new-password" aria-required="true" />
                        <span asp-validation-for="Input.Password" class="text-danger"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="Input.ConfirmPassword" class="form-label">Confirm password</label>
                        <input asp-for="Input.ConfirmPassword" class="form-control" autocomplete="new-password" aria-required="true" />
                        <span asp-validation-for="Input.ConfirmPassword" class="text-danger"></span>
                    </div>

                    <button id="registerAgentSubmit" type="submit" class="w-100 btn btn-primary">Register</button>
                </form>

                <hr class="my-4" />

                <p class="mb-1">
                    Already have an account? <a asp-page="./Login" asp-route-returnUrl="@Model.ReturnUrl">Log in</a>
                </p>
                <p class="mb-0">
                    Not an agent? <a asp-page="./Register" asp-route-returnUrl="@Model.ReturnUrl">Create a regular account</a>
                </p>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

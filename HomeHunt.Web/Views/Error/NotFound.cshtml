@model ErrorViewModel
@{
    ViewData["Title"] = "Page not found";
}

<div class="text-center py-5">
    <p class="display-1 fw-bold text-primary mb-0">404</p>
    <h1 class="h3 mb-3">Page not found</h1>
    <p class="text-muted mb-4">
        The page you are looking for doesn't exist, was moved, or the property has already been removed.
    </p>
    <a class="btn btn-primary me-2" asp-controller="Home" asp-action="Index">Back to home</a>
    <a class="btn btn-outline-primary" asp-controller="Properties" asp-action="Index">Browse properties</a>
</div>

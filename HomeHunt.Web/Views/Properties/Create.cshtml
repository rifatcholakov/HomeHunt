@model PropertyFormViewModel

@{
    ViewData["Title"] = "Add Property";
}

<h1 class="h2 mb-3">Add Property</h1>

<div class="row">
    <div class="col-lg-8">
        <form asp-action="Create" method="post" enctype="multipart/form-data">
            <partial name="_PropertyForm" model="Model" />

            <button type="submit" class="btn btn-primary">Save</button>
            <a class="btn btn-outline-secondary" asp-action="Index">Cancel</a>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/lib/sortablejs/Sortable.min.js"></script>
    <script type="module" src="~/js/property-images.js" asp-append-version="true"></script>
}

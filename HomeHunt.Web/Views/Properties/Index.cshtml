@model PropertySearchViewModel

@{
    ViewData["Title"] = "All Properties";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h2 mb-0">All Properties</h1>
    <a class="btn btn-primary" asp-action="Create">Add Property</a>
</div>

<form asp-action="Index" method="get" class="card card-body mb-4">
    <div asp-validation-summary="All" class="text-danger"></div>

    <div class="row g-3">
        <div class="col-md-3">
            <label asp-for="City" class="form-label"></label>
            <select asp-for="City" asp-items="@(new SelectList(Model.Cities))" class="form-select">
                <option value="">All cities</option>
            </select>
        </div>

        <div class="col-md-3">
            <label asp-for="PropertyType" class="form-label"></label>
            <select asp-for="PropertyType" asp-items="Html.GetEnumSelectList<PropertyType>()" class="form-select">
                <option value="">All types</option>
            </select>
        </div>

        <div class="col-md-3">
            <label asp-for="ListingType" class="form-label"></label>
            <select asp-for="ListingType" asp-items="Html.GetEnumSelectList<ListingType>()" class="form-select">
                <option value="">Sale and rent</option>
            </select>
        </div>

        <div class="col-md-3">
            <label asp-for="SortBy" class="form-label"></label>
            <select asp-for="SortBy" class="form-select">
                <option value="newest">Newest first</option>
                <option value="priceAsc">Price: low to high</option>
                <option value="priceDesc">Price: high to low</option>
                <option value="area">Largest area</option>
            </select>
        </div>

        <div class="col-md-3">
            <label asp-for="MinPrice" class="form-label"></label>
            <input asp-for="MinPrice" class="form-control" />
        </div>

        <div class="col-md-3">
            <label asp-for="MaxPrice" class="form-label"></label>
            <input asp-for="MaxPrice" class="form-control" />
        </div>

        <div class="col-md-3">
            <label asp-for="MinBedrooms" class="form-label"></label>
            <input asp-for="MinBedrooms" class="form-control" />
        </div>

        <div class="col-md-3">
            <label asp-for="MinArea" class="form-label"></label>
            <input asp-for="MinArea" class="form-control" />
        </div>
    </div>

    <div class="mt-3">
        <button type="submit" class="btn btn-primary">Search</button>
        <a class="btn btn-outline-secondary" asp-action="Index">Clear filters</a>
    </div>
</form>

@if (ViewData.ModelState.IsValid)
{
    <p class="text-muted">@Model.Properties.Count properties found</p>

    @if (Model.Properties.Count == 0)
    {
        <p>No properties match your search. <a asp-action="Index">Clear filters</a></p>
    }
    else
    {
        <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
            @foreach (PropertyListViewModel property in Model.Properties)
            {
                <partial name="_PropertyCard" model="property" />
            }
        </div>
    }
}

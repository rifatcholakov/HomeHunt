@model List<PropertyListViewModel>

@{
    ViewData["Title"] = "My Favorites";
}

<h1 class="h2 mb-3" data-favorites-page>My Favorites</h1>

@if (Model.Count == 0)
{
    <p>You haven't saved any properties yet. <a asp-controller="Properties" asp-action="Index">Browse properties</a></p>
}
else
{
    <p class="text-muted" data-favorites-count>@Model.Count saved properties</p>

    <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
        @foreach (PropertyListViewModel property in Model)
        {
            <partial name="_PropertyCard" model="property" />
        }
    </div>
}

@model AgentDetailsViewModel

@{
    ViewData["Title"] = Model.FirstName + " " + Model.LastName;
}

<div class="d-flex flex-wrap justify-content-between align-items-start mb-4">
    <div>
        <h1 class="h2 mb-1">@Model.FirstName @Model.LastName</h1>
        <p class="text-muted mb-0">@Model.AgencyName</p>
    </div>
    <div>
        <a class="btn btn-primary" asp-action="Edit" asp-route-id="@Model.Id">Edit Agent</a>
        <a class="btn btn-outline-danger" asp-action="Delete" asp-route-id="@Model.Id">Delete Agent</a>
    </div>
</div>

<div class="card card-body mb-4">
    <h2 class="h5">Contact</h2>
    <p class="mb-1">Email: <a href="mailto:@Model.Email">@Model.Email</a></p>
    <p class="mb-0">Phone: <a href="tel:@Model.Phone">@Model.Phone</a></p>
</div>

<div class="row g-3 text-center mb-4">
    <div class="col-md-4">
        <div class="card card-body">
            <span class="display-6">@Model.PropertyCount</span>
            <span class="text-muted">Properties</span>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card card-body">
            <span class="display-6">@Model.ForSaleCount</span>
            <span class="text-muted">Available for sale</span>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card card-body">
            <span class="display-6">@Model.ForRentCount</span>
            <span class="text-muted">Available for rent</span>
        </div>
    </div>
</div>

<section class="mb-5">
    <h2 class="h4 mb-3">Properties of @Model.FirstName @Model.LastName</h2>

    @if (Model.Properties.Count == 0)
    {
        <p class="text-muted">This agent has no properties yet.</p>
        <a class="btn btn-outline-primary" asp-controller="Properties" asp-action="Create">Add Property</a>
    }
    else
    {
        <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
            @foreach (PropertyListViewModel property in Model.Properties)
            {
                <partial name="_PropertyCard" model="property" />
            }
        </div>
    }
</section>

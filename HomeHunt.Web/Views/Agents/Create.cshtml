@model AgentCreateViewModel

@{
    ViewData["Title"] = "Add Agent";
}

<h1 class="h2 mb-3">Add Agent</h1>

<div class="row">
    <div class="col-md-6">
        <form asp-action="Create" method="post">
            <partial name="_AgentForm" model="Model" />

            <div class="mb-3">
                <label asp-for="Password" class="form-label"></label>
                <input asp-for="Password" class="form-control" autocomplete="new-password" />
                <span asp-validation-for="Password" class="text-danger"></span>
                <div class="form-text">The agent signs in with this email and password.</div>
            </div>

            <button type="submit" class="btn btn-primary">Save</button>
            <a class="btn btn-outline-secondary" asp-action="Index">Cancel</a>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
